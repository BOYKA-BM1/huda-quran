{"code":200,"status":"OK","data":{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"numberInSurah":1,"text":"Say, \"I seek refuge in the Lord of daybreak","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6227,"numberInSurah":2,"text":"From the evil of that which He created","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6228,"numberInSurah":3,"text":"And from the evil of darkness when it settles","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6229,"numberInSurah":4,"text":"And from the evil of the blowers in knots","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6230,"numberInSurah":5,"text":"And from the evil of an envier when he envies.\"","juz":30,"page":604,"hizbQuarter":240,"sajda":false}]}}