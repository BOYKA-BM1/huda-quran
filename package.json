{
  "name": "huda-al-quran",
  "version": "2.1.0",
  "private": true,
  "description": "Huda Al Quran — complete Quran app with recitation, prayer, adhkar, competitions",
  "scripts": {
    "serve": "node scripts/serve.js",
    "data": "node scripts/fetch-data.js",
    "data:all": "node scripts/fetch-data.js --all",
    "data:check": "node scripts/fetch-data.js --check",
    "validate:data": "node scripts/fetch-data.js --check",
    "test": "node tests/core.test.js",
    "android:add": "cap add android && node scripts/patch-android.js",
    "android:sync": "cap sync android && node scripts/patch-android.js",
    "android:open": "cap open android",
    "test:backend": "npm --prefix backend install --no-audit --no-fund && npm --prefix backend test",
    "validate:release": "node scripts/validate-release.js",
    "check:all": "npm run validate:data && npm test && npm run validate:release"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
