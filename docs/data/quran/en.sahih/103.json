{"code":200,"status":"OK","data":{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6177,"numberInSurah":1,"text":"By time,","juz":30,"page":601,"hizbQuarter":240,"sajda":false},{"number":6178,"numberInSurah":2,"text":"Indeed, mankind is in loss,","juz":30,"page":601,"hizbQuarter":240,"sajda":false},{"number":6179,"numberInSurah":3,"text":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","juz":30,"page":601,"hizbQuarter":240,"sajda":false}]}}