{"code":200,"status":"OK","data":{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6231,"numberInSurah":1,"text":"قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس.","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6232,"numberInSurah":2,"text":"ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم.","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6233,"numberInSurah":3,"text":"إله الناس الذي لا معبود بحق سواه.","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6234,"numberInSurah":4,"text":"من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله.","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6235,"numberInSurah":5,"text":"الذي يبثُّ الشر والشكوك في صدور الناس.","juz":30,"page":604,"hizbQuarter":240,"sajda":false},{"number":6236,"numberInSurah":6,"text":"من شياطين الجن والإنس.","juz":30,"page":604,"hizbQuarter":240,"sajda":false}]}}