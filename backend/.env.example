# ── انسخ هذا الملف إلى .env (لا ترفع .env إلى GitHub أبداً) ──
NODE_ENV=development
PORT=3000

# مفتاح Groq: من console.groq.com — يبقى على السيرفر فقط، لا يوضع في الواجهة إطلاقاً
GROQ_API_KEY=

# اختياري: تغيير النماذج بدون تعديل الكود (مفصولة بفاصلة، بالترتيب)
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# أصول الموقع المسموحة (CORS) مفصولة بفاصلة. تطبيق الموبايل (Capacitor) مسموح تلقائياً.
# التطوير: يمكن * — الإنتاج (NODE_ENV=production): ممنوع *؛ السيرفر لن يعمل إلا بقائمة صريحة
# مثال إنتاج: FRONTEND_URL=https://your-domain.com,https://www.your-domain.com
FRONTEND_URL=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_AI_MAX=12

# Auth
AUTH_SECRET=change-this-long-random-string
